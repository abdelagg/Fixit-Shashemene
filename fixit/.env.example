# INFERENCE_API_KEY: used by the server-side diagnostic engine's inference client.
# Set this in your local .env for development. In production, set it in your
# hosting provider's environment variables (e.g. Vercel: Project Settings ->
# Environment Variables) -- do not commit real keys to this file.
INFERENCE_API_KEY="your-api-key-here"

# APP_URL: the public URL this app is hosted at, used for self-referential
# links and callback URLs. Set this to your production domain once deployed.
APP_URL="https://your-app-domain.com"
